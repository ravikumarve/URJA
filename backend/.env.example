# URJA Configuration
DEBUG=false
DATABASE_URL=postgresql+asyncpg://urja:urja@localhost:5432/urja
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-256-bit-key
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_AUTH=100
RATE_LIMIT_UNAUTH=10

# TimescaleDB
TELEMETRY_RETENTION_DAYS=730
TELEMETRY_CHUNK_INTERVAL_DAYS=7
TELEMETRY_COMPRESS_AFTER_DAYS=30

# Carbon
CARBON_CREDIT_PER_MWH=0.73
MRV_METHODOLOGY_VERSION=URJA-VCS-1.0

# Health
HEALTH_ANOMALY_THRESHOLD=0.15
HEALTH_SCAN_INTERVAL_MINUTES=60

# Seed Data
SEED_ORG_NAME=GreenEnergy Corp
SEED_SITE_NAME=Rajasthan Solar Farm
SEED_SITE_CAPACITY_MW=50.0
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
