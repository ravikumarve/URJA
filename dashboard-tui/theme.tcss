/* URJA Amber CRT Theme — Textual CSS v8 */

Screen {
    background: #0a0500;
}

* {
    color: #ffb703;
}

/* ── SCROLLBAR ── */
Scrollbar {
    color: #8a6300;
}
Scrollbar:hover {
    color: #ffb703;
}

/* ── HEADER BAR ── */
#screen-header {
    height: 3;
    background: #ffb703;
    margin: 0 0 1 0;
}
#screen-header > Static {
    color: #0a0500;
    background: #ffb703;
    text-style: bold;
    height: 3;
}
#screen-header > #header-title {
    padding: 0 2;
    width: 1fr;
}
#screen-header > #header-alert,
#screen-header > #header-total-lost,
#screen-header > #header-alert-count {
    width: auto;
    padding: 0 1;
}
#screen-header > #header-status,
#screen-header > #header-total-lost-label,
#screen-header > #header-alert-label {
    width: auto;
    padding: 0 1;
}
#screen-header > .alert {
    color: #0a0500;
    background: #ff5e00;
}
#screen-header > .dim {
    color: #0a0500;
    background: #ffb703;
}

/* ── KPI ROW ── */
#kpi-row {
    height: 9;
    margin: 0 0 1 0;
}

KpiCard {
    border: solid #8a6300;
    height: 8;
    width: 1fr;
    min-width: 18;
    margin: 0 1 0 0;
    padding: 0 1;
}
KpiCard > Label.title {
    background: #0a0500;
    color: #ffb703;
    text-style: bold;
    padding: 0 1;
    height: 1;
    min-width: 10;
    margin: 0;
}
KpiCard > Static.value {
    content-align: center middle;
    text-style: bold;
    color: #ffb703;
    height: 3;
}
KpiCard > Static.label {
    content-align: center middle;
    color: #8a6300;
    height: 1;
}
KpiCard.alert {
    border: solid #ff5e00;
}
KpiCard.alert > Static.value {
    color: #ff5e00;
}
KpiCard.alert > Label.title {
    color: #ff5e00;
}

/* ── PANEL CONTAINERS ── */
.panel {
    border: solid #8a6300;
    margin: 0 0 1 0;
    padding: 1 0;
}
.panel.alert-border {
    border: solid #ff5e00;
}

/* ── PANEL TITLE ── */
.panel-title {
    background: #0a0500;
    color: #ffb703;
    text-style: bold;
    padding: 0 1;
    height: 1;
    margin: 0;
}

/* ── DATA TABLES ── */
DataTable {
    border: solid #8a6300;
    margin: 0 0 1 0;
    height: 1fr;
    min-height: 8;
}
DataTable > .datatable--header {
    color: #8a6300;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: #1a0e00;
    color: #ffb703;
}
DataTable > .datatable--hover {
    background: #1a0e00;
}

/* ── RICH LOG ── */
RichLog {
    border: solid #8a6300;
    margin: 0 0 0 0;
    padding: 0 1;
    height: 12;
    min-height: 8;
}

/* ── ALERT TEXT ── */
.alert {
    color: #ff5e00;
    text-style: bold;
}
.critical {
    color: #ef4444;
    text-style: bold;
}
.ok {
    color: #4ade80;
    text-style: bold;
}
.dim {
    color: #8a6300;
}

/* ── BLINK (via Python timer toggle) ── */
.blink-off {
    opacity: 0.3;
}

/* ── FOOTER / HOTKEY BAR ── */
Footer {
    background: #0a0500;
    color: #8a6300;
    border-top: solid #8a6300;
    height: 3;
}
Footer > .footer--key {
    background: #ffb703;
    color: #0a0500;
    text-style: bold;
    padding: 0 1;
    margin: 0 0 0 1;
}
Footer > .footer--description {
    color: #8a6300;
    background: #0a0500;
    padding: 0 1 0 0;
}
Footer > .footer--highlight {
    background: #ff5e00;
    color: #0a0500;
}

/* ── VERTICAL / HORIZONTAL LAYOUTS ── */
Horizontal {
    height: auto;
}
Vertical {
    height: auto;
}

/* ── WORKER LOG ── */
#worker-log {
    height: 10;
    margin: 0 0 1 0;
}
#dispatch-log {
    height: 10;
    margin: 0 0 1 0;
}
#alerts-panel {
    height: 12;
    border: solid #ff5e00;
    margin: 0 0 1 0;
}
/* Per-screen table heights — fill remaining space */
#asset-table {
    height: 1fr;
    min-height: 12;
}
#curtailment-table {
    height: 1fr;
    min-height: 10;
}
#carbon-table {
    height: 1fr;
    min-height: 10;
}
#health-table {
    height: 1fr;
    min-height: 12;
}
